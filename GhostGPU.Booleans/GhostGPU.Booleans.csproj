<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GhostGPU.Booleans</RootNamespace>
    <AssemblyName>GhostGPU.Booleans</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ILGPU" Version="1.5.3" />
    <PackageReference Include="ILGPU.Algorithms" Version="1.5.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Numerics" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GhostGPU.Booleans.Validation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GhostGPU.Core\GhostGPU.Core.csproj" />
    <ProjectReference Include="..\GhostGPU.Runtime\GhostGPU.Runtime.csproj" />
  </ItemGroup>
</Project>
