<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GhostGPU.Booleans.Validation</RootNamespace>
    <AssemblyName>GhostGPU.Booleans.Validation</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ILGPU" Version="1.5.3" />
    <PackageReference Include="ILGPU.Algorithms" Version="1.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GhostGPU.Core\GhostGPU.Core.csproj" />
    <ProjectReference Include="..\GhostGPU.Runtime\GhostGPU.Runtime.csproj" />
    <ProjectReference Include="..\GhostGPU.Booleans\GhostGPU.Booleans.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
